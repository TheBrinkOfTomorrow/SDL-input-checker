{
  "version": 6,
  "configurePresets": [
    { "name": "debug",   "binaryDir": "${sourceDir}/build/debug",   "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "binaryDir": "${sourceDir}/build/release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "asan",    "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
                          "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined" } },
    { "name": "macos-bundle", "binaryDir": "${sourceDir}/build/macos-bundle",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SIC_MACOS_BUNDLE": "ON" } }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan",    "configurePreset": "asan" },
    { "name": "macos-bundle", "configurePreset": "macos-bundle" }
  ]
}
